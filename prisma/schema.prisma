// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("VIEWER") // SUPER_ADMIN, ADMIN, ACCOUNTANT, SALES_STAFF, VIEWER
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("ACTIVE") // ACTIVE, DISABLED
}

model Company {
  id             String    @id @default(uuid())
  name           String
  gstin          String?
  address        String?
  financialYear  String?
  tallyConnected Boolean   @default(false)
  lastSyncTime   DateTime?
  lastAlterId    Int       @default(0)
  lastSyncStatus String?   @default("IDLE") // SUCCESS, FAILED, IN_PROGRESS, IDLE
  lastSyncError  String?
  lastSyncDetails String?
  users          User[]
  ledgers        Ledger[]
  inventory      InventoryItem[]
  syncLogs       SyncLog[]
  salesPeople    SalesPerson[]
  visitLogs      VisitLog[]
  paymentReminders PaymentReminder[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relations to transactions and vouchers can be derived from ledgers or directly linked
  vouchers       Voucher[]
}

model Ledger {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tallyGuid      String?
  masterId       Int?
  alterId        Int?
  name           String
  group          String    @default("Sundry Debtors") // Sundry Debtors, Sundry Creditors, Cash-in-Hand, Bank Accounts, etc.
  openingBalance Float     @default(0)
  closingBalance Float     @default(0)
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  gstin          String?
  type           String    @default("Customer") // Customer, Supplier, Cash, Bank, etc.
  
  creditLimit    Float?
  creditDays     Int?
  salesPersonId  String?
  salesPerson    SalesPerson? @relation(fields: [salesPersonId], references: [id])
  
  vouchersParty  Voucher[] @relation("PartyLedger")
  vouchersSales  Voucher[] @relation("SalesLedger")
  visitLogs      VisitLog[]
  paymentReminders PaymentReminder[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, tallyGuid])
  @@index([companyId, name])
  @@index([companyId, type])
  @@index([companyId, salesPersonId])
}

model SalesPerson {
  id                String            @id @default(uuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  phone             String?
  email             String?
  code              String?
  status            String            @default("ACTIVE") // ACTIVE, INACTIVE
  assignedCustomers Ledger[]
  visitLogs         VisitLog[]
  paymentReminders  PaymentReminder[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([companyId, status])
}

model CustomerAssignment {
  id             String    @id @default(uuid())
  companyId      String
  customerId     String
  salesPersonId  String
  status         String    @default("ACTIVE") // ACTIVE, HISTORICAL
  assignedAt     DateTime  @default(now())
  unassignedAt   DateTime?

  @@index([companyId, customerId])
  @@index([companyId, salesPersonId])
}

model VisitLog {
  id                String       @id @default(uuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Ledger       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesPersonId     String?
  salesPerson       SalesPerson? @relation(fields: [salesPersonId], references: [id])
  visitDate         DateTime
  purpose           String?
  notes             String?
  outcome           String       @default("PLANNED") // PLANNED, COMPLETED, FOLLOW_UP, CANCELLED
  nextFollowUpDate  DateTime?
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([companyId, customerId])
  @@index([companyId, salesPersonId])
  @@index([companyId, visitDate])
  @@index([companyId, outcome])
}

model PaymentReminder {
  id                String       @id @default(uuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Ledger       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesPersonId     String?
  salesPerson       SalesPerson? @relation(fields: [salesPersonId], references: [id])
  amount            Float?
  reminderDate      DateTime
  note              String?
  status            String       @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, reminderDate])
  @@index([companyId, status, reminderDate])
}

model InventoryItem {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tallyGuid      String?
  masterId       Int?
  alterId        Int?
  name           String
  category       String?
  unit           String    @default("Nos")
  hsnCode        String?
  taxRate        Float     @default(0)
  openingStock   Float     @default(0)
  currentStock   Float     @default(0)
  purchasePrice  Float     @default(0)
  salesPrice     Float     @default(0)
  minStockLevel  Float     @default(0)
  
  voucherItems   VoucherItem[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, tallyGuid])
  @@index([companyId, name])
}

model Voucher {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tallyGuid      String?
  masterId       Int?
  alterId        Int?
  vNo            String
  type           String    // Sales, Purchase, Receipt, Payment, Journal, Contra
  date           DateTime
  
  partyId        String?
  party          Ledger?   @relation("PartyLedger", fields: [partyId], references: [id])
  
  ledgerId       String?
  ledger         Ledger?   @relation("SalesLedger", fields: [ledgerId], references: [id])
  
  amount         Float     @default(0)
  narration      String?
  status         String    @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  
  items          VoucherItem[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, tallyGuid])
  @@index([companyId, alterId])
  @@index([companyId, vNo])
  @@index([companyId, date])
  @@index([companyId, type])
  @@index([companyId, partyId])
}

model VoucherItem {
  id             String    @id @default(uuid())
  voucherId      String
  voucher        Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  
  itemId         String?
  item           InventoryItem? @relation(fields: [itemId], references: [id])
  
  description    String?
  quantity       Float     @default(0)
  rate           Float     @default(0)
  amount         Float     @default(0)
  discount       Float     @default(0)
  taxAmount      Float     @default(0)

  @@index([voucherId])
  @@index([itemId])
}

model SyncLog {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status         String    // SUCCESS, FAILED, IN_PROGRESS
  startTime      DateTime  @default(now())
  endTime        DateTime?
  recordsSynced  Int       @default(0)
  recordsReceived Int      @default(0)
  recordsCreated Int       @default(0)
  recordsUpdated Int       @default(0)
  recordsSkipped Int       @default(0)
  recordsDeleted Int       @default(0)
  alterIdBefore  Int?
  alterIdAfter   Int?
  errorDetails   String?

  @@index([companyId, startTime])
}

model AuditLog {
  id             String    @id @default(uuid())
  userId         String?
  action         String
  entity         String
  entityId       String?
  details        String?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@index([action])
}
